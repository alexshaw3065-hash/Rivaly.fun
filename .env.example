# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (avatar uploads). Both are meant to be public — that's how
# unsigned uploads work. Cloud name is on your dashboard; the preset is
# created under Settings -> Upload -> Upload presets (Signing Mode:
# Unsigned).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Dynamic.xyz (login: Google/Apple/email + a secondary wallet-connect
# option, with a silent embedded Solana wallet behind every social/email
# signup). Environment ID is on your Dynamic dashboard — public by design,
# it's what the client SDK and the server's JWT verification both key off.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Solana RPC, used to read balances and to reconcile the transaction log
# against the chain. Transactions are still signed and sent by Dynamic's own
# connector, never here. Both are optional and default to the public Devnet
# endpoint (rate-limited, fine at current volume).
#
# Prefer the server-only one for a provider URL that embeds an API key
# (Helius, QuickNode): it's used by the server-side reconciler and never
# ships to the browser. The NEXT_PUBLIC one is read by the client's own
# balance polling, so only put a key-less or domain-restricted URL there.
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=

# Real deposits/withdrawals run on Solana Devnet for now (test money only —
# see the deposits/withdrawals plan's "Explicitly out of scope" for the
# deliberate Mainnet migration step). No env var needed today — the Devnet
# USDC mint (4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU, Circle's own,
# usable via faucet.circle.com) is hardcoded in src/lib/wallet/constants.ts
# alongside the other wallet constants, same as every other chain-specific
# value in that file. Move it here if/when Mainnet needs a different value
# per environment.
