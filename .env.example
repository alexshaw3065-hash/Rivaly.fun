# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (avatar uploads). Both are meant to be public — that's how
# unsigned uploads work. Cloud name is on your dashboard; the preset is
# created under Settings -> Upload -> Upload presets (Signing Mode:
# Unsigned).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
