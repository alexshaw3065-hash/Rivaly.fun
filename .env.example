# --- Waitlist Supabase project (separate, small project just for signups) ---
# Server-only; used by the /api/waitlist route. Get these from the waitlist
# project's Settings -> API. The service role key must never reach the client.
WAITLIST_SUPABASE_URL=
WAITLIST_SUPABASE_SERVICE_ROLE_KEY=

# --- Main-site Supabase project (the real product database; not used yet) ---
# Settings -> API in the main Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
